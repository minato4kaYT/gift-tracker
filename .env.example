# --- Telegram bot ---
BOT_TOKEN=123456:ABC-yourBotTokenFromBotFather

# Chat (group/channel) where listing cards are posted. Add the bot as ADMIN there.
# For a supergroup the id looks like -1001234567890.
LOG_CHAT_ID=

# Comma-separated admin user ids (can use /demo).
ADMIN_IDS=1430080776

DB_PATH=/root/gift-tracker-demo/demo.db

# Premium custom-emoji: needs the BOT OWNER to have Telegram Premium.
# 0 = plain emoji (safe demo), 1 = premium tg-emoji.
USE_PREMIUM_EMOJI=0

# Trial length (hours)
TRIAL_HOURS=3

# Demo feed: auto-post a fake listing every N seconds (1=on, 0=off)
DEMO_FEED_ENABLED=1
DEMO_FEED_INTERVAL=25

# --- PRODUCTION userbot (only for sources/tg_native.py, not the plain demo) ---
# USERBOT_API_ID=
# USERBOT_API_HASH=
# USERBOT_SESSION=

# --- Автосвап TON -> USDT на STON.fi (каждый день в 23:59 МСК) ---
# SWAP_ENABLED=1
# TONKEEPER_MNEMONIC=word1 word2 ... word24   # сид кошелька TONKEEPER_WALLET (W5)
# SWAP_ASK_JETTON=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs  # USDT (по умолч.)
# SWAP_SLIPPAGE=0.01
# SWAP_MAX_IMPACT=0.05
# SWAP_GAS_RESERVE_TON=0.3
# SWAP_MIN_TON=1.0
# SWAP_HOUR=23
# SWAP_MINUTE=59
# SWAP_TZ_OFFSET=3

# Набор рабочих: 1 - заявки открыты, 0 - "временно неактуально" + оффер триала
# WORKER_HIRING_ENABLED=0

# Обязательная подписка на канал (пусто = выкл). Бот ДОЛЖЕН быть админом канала!
# REQUIRED_CHANNEL=@adapterOnyxHub
# REQUIRED_CHANNEL_INVITE=            # invite-ссылка для приватного канала (иначе t.me/<username>)
